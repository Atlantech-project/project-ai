{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlantech.io/contracts/ai/envelope.schema.json",
  "title": "AI job envelope (CT-08)",
  "description": "Outer message for every job the Backend RPUSHes to an AI worker queue. contract_version 1.x. Payloads are validated against the per-job-type schemas C-01 to C-05.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "job_type", "job_id", "run_id", "enqueued_at", "triggered_by_user_id", "payload"],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Message format version. Workers accept every 1.x."
    },
    "job_type": {
      "type": "string",
      "enum": ["PART1_RUN", "PART2_SOLVE", "YARD_PLACEMENT", "BAPLIE_PARSE", "VALIDATION"]
    },
    "job_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "Generated by the Backend, unique per message; correlation key in C-06."
    },
    "run_id": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Id of the QUEUED run row: part1_runs, solver_runs, yard_runs or baplie_parse_runs. Null only for VALIDATION."
    },
    "enqueued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC timestamp set by the Backend just before RPUSH."
    },
    "triggered_by_user_id": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "User who started the job, or null for an automatic trigger. Required non-null for VALIDATION."
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "job_type": { "const": "PART1_RUN" } }, "required": ["job_type"] },
      "then": { "properties": { "run_id": { "type": "integer" }, "payload": { "$ref": "c01-part1-run.schema.json" } } }
    },
    {
      "if": { "properties": { "job_type": { "const": "PART2_SOLVE" } }, "required": ["job_type"] },
      "then": { "properties": { "run_id": { "type": "integer" }, "payload": { "$ref": "c02-part2-solve.schema.json" } } }
    },
    {
      "if": { "properties": { "job_type": { "const": "YARD_PLACEMENT" } }, "required": ["job_type"] },
      "then": { "properties": { "run_id": { "type": "integer" }, "payload": { "$ref": "c03-yard.schema.json" } } }
    },
    {
      "if": { "properties": { "job_type": { "const": "BAPLIE_PARSE" } }, "required": ["job_type"] },
      "then": { "properties": { "run_id": { "type": "integer" }, "payload": { "$ref": "c04-baplie.schema.json" } } }
    },
    {
      "if": { "properties": { "job_type": { "const": "VALIDATION" } }, "required": ["job_type"] },
      "then": {
        "properties": {
          "run_id": { "type": "null" },
          "triggered_by_user_id": { "type": "integer" },
          "payload": { "$ref": "c05-validation.schema.json" }
        }
      }
    }
  ]
}
